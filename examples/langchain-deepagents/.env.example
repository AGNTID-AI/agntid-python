# Local AgntID runtime started from the repository docker-compose.yml.
AGNTID_MCP_URL=http://localhost:8082/mcp

# Optional raw OAuth access token when the runtime requires authenticated MCP
# access. Never commit a real token or include the "Bearer" prefix here.
AGNTID_ACCESS_TOKEN=

# Any LangChain model identifier accepted by init_chat_model can be used.
MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# These are demonstration defaults. In production they must come from trusted
# authentication and deployment configuration, never from prompt text.
AGENT_ID=deepagents-demo-agent
USER_ID=demo-user
